# API base URL (the FastAPI backend). Use the Render URL in production, with no
# trailing slash. Must be reachable from the browser, not just from the server.
VITE_API_URL=http://127.0.0.1:8000

# Google OAuth client ID (must match backend GOOGLE_CLIENT_ID)
# Create one at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Google OAuth redirect URI — the FRONTEND origin. Must match an entry under
# "Authorized redirect URIs" in Google Cloud Console, and must be listed in the
# backend's FRONTEND_URL/ALLOWED_ORIGINS or login is rejected.
VITE_GOOGLE_REDIRECT_URI="http://localhost:5173"

# Upload limit in MB shown to the user and enforced before upload.
# Must match the backend's MAX_UPLOAD_SIZE_MB — the server is authoritative and
# returns 413 for anything larger.
VITE_MAX_UPLOAD_SIZE_MB=25