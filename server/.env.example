# ── Image Processing API — configuration ──
# Copy to .env and fill in.  Everything below is optional in development
# (defaults exist), but these are required for a production deploy.

# JWT signing secret — REQUIRED in production.  Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 chars and not a known placeholder.  A missing/insecure value is
# auto-generated per-process (which logs everyone out on every restart).
SECRET_KEY=""

# ── Database ──
# Easiest for managed Postgres (Neon/Render/Supabase): paste the full URL here.
DATABASE_URL="postgresql+asyncpg://user:pass@host:5432/db?sslmode=require"
# …or set the individual fields instead (DATABASE_URL wins if both set):
# POSTGRES_HOST=""
# POSTGRES_PORT=5432
# POSTGRES_DB=""
# POSTGRES_USER=""
# POSTGRES_PASSWORD=""
# POSTGRES_SSLMODE="require"

# ── CORS ──
# Comma-separated or JSON array of the deployed frontend origin(s).
ALLOWED_ORIGINS="https://your-app.vercel.app, https://your-app.vercel.app2"

# ── Google OAuth ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Storage ──
# local = filesystem under server/data (dev only; lost on Render free redeploys)
# s3    = S3-compatible object storage (Cloudflare R2 free tier recommended)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="data/uploads"
# S3 / R2:
# S3_BUCKET=""
# S3_ENDPOINT_URL="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_REGION="auto"
CHUNK_UPLOAD_DIR="data/chunks"

# ── Misc ──
# Set true during development only to expose /docs and /openapi.json.
DEBUG_OPENAPI="false"
# Upload limit in MB (default 2560).
MAX_UPLOAD_SIZE_MB=2560
# Auth rate limit: requests per minute per IP.
RATE_LIMIT_PER_MINUTE=30