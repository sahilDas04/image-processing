# ── Image Processing API — configuration ──
# Copy to .env and fill in.  Everything below is optional in development
# (defaults exist), but these are required for a production deploy.

# JWT signing secret — REQUIRED in production.  Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 chars and not a known placeholder.  A missing/insecure value is
# auto-generated per-process (which logs everyone out on every restart).
SECRET_KEY=""

# ── Database ──
# Easiest for managed Postgres (Neon/Render/Supabase): paste the full URL here.
# Paste it EXACTLY as the provider gives it — the app rewrites the scheme to the
# postgresql+asyncpg driver and maps sslmode/channel_binding to asyncpg's ssl.
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
# …or set the individual fields instead (DATABASE_URL wins if both set):
# POSTGRES_HOST=""
# POSTGRES_PORT=5432
# POSTGRES_DB=""
# POSTGRES_USER=""
# POSTGRES_PASSWORD=""
# POSTGRES_SSLMODE="require"

# ── CORS ──
# Comma-separated or JSON array of the deployed frontend origin(s).
# Must NOT contain '*' — the app refuses to boot on a wildcard CORS policy.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Production frontend origin. Used to validate the OAuth redirect_uri the SPA
# sends back during code exchange, so login works on a deployed frontend
# without a code change. Include the dev origins above to keep local working.
FRONTEND_URL=""

# ── Google OAuth ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Storage ──
# local       = filesystem under server/data (dev only; lost on every Render
#               redeploy because the free-tier filesystem is ephemeral)
# cloudinary  = persistent media storage (required for production)
# s3          = S3-compatible object storage (Cloudflare R2, MinIO, AWS)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="data/uploads"

# Cloudinary — production storage. Dashboard → Settings → API Keys.
# The API secret belongs ONLY on the backend. Never expose it as a VITE_*
# variable, or it ships to every browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# All assets are nested under this folder to keep them separate from anything
# else in the same account.
CLOUDINARY_FOLDER="image-processing"
# "private" (default) keeps assets unreadable without the API secret, so the
# backend's per-user authorization checks stay meaningful. Use "upload" only if
# you accept that every asset is world-readable by URL.
CLOUDINARY_DELIVERY_TYPE="private"

# S3 / R2 (alternative to Cloudinary):
# S3_BUCKET=""
# S3_ENDPOINT_URL="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_REGION="auto"

CHUNK_UPLOAD_DIR="data/chunks"
# ⚠ Chunked uploads are staged on LOCAL disk, which is ephemeral on Render's
# free tier — any redeploy mid-upload discards in-flight sessions, and the
# endpoint breaks entirely if the service ever runs more than one instance.
# Object storage does not help here; only a persistent disk does.

# ── Misc ──
# Set true to expose /docs, /redoc and /openapi.json. Leave false in production.
DEBUG_OPENAPI="false"
# Upload limit in MB. Keep this low (25-50) on Render's free tier: a 512 MB
# instance buffers uploads in memory before decoding, so large files OOM the
# process. Must match the frontend's VITE_MAX_UPLOAD_SIZE_MB, otherwise the UI
# will advertise a different limit than the API enforces.
MAX_UPLOAD_SIZE_MB=25
# Auth rate limit: requests per minute per IP. In-process only, so it resets
# whenever the free instance sleeps and does not apply across workers.
RATE_LIMIT_PER_MINUTE=30